# Copier ce fichier en .env puis remplir les valeurs. Ne jamais committer .env.

# Clé secrète de session (chaîne aléatoire longue)
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=changez-moi

# Envoi d'e-mails (mot de passe oublié, mot de passe temporaire).
# Facultatif pour la démo : la connexion des comptes de démo n'en a pas besoin.
EMAIL_DSI=
EMAIL_DSI_MOT_DE_PASSE=

# Clé API de l'agent de collecte PowerShell
AGENT_API_KEY=changez-moi

# URL publique utilisée dans les e-mails de réinitialisation
APP_BASE_URL=http://localhost
