# Copier ce fichier vers .env et remplir les vraies valeurs.
# Ne jamais committer le fichier .env réel.

# Clé secrète de session (générer une valeur aléatoire longue et unique)
SESSION_SECRET_KEY=

# Identifiants d'envoi d'email (2FA, mot de passe oublié, création de compte)
EMAIL_DSI=
EMAIL_DSI_MOT_DE_PASSE=

# Clé API pour l'agent de récupération réseau (doit correspondre à $apiKey
# dans deployment/script.ps1 déployé sur les postes)
AGENT_API_KEY=

# URL publique de l'application, utilisée dans les emails de réinitialisation
APP_BASE_URL=http://localhost

# Afficher les requêtes SQL dans les logs (déconseillé en production)
SQL_ECHO=false

# Vérifier le certificat TLS lors de la synchronisation ManageEngine
MANAGEENGINE_VERIFY_SSL=true
